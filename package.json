{
  "name": "threadforge",
  "private": true,
  "version": "0.9.7",
  "type": "module",
  "workspaces": [
    "frontends/image-board",
    "frontends/file-uploader",
    "frontends/guide-posts",
    "frontends/proxy-release",
    "frontends/materials-library"
  ],
  "scripts": {
    "dev:image-board": "npm --prefix frontends/image-board run dev",
    "dev:file-uploader": "npm --prefix frontends/file-uploader run dev",
    "dev:guide-posts": "npm --prefix frontends/guide-posts run dev",
    "dev:proxy-release": "npm --prefix frontends/proxy-release run dev",
    "dev:materials-library": "npm --prefix frontends/materials-library run dev",
    "build:image-board": "npm --prefix frontends/image-board run build",
    "build:file-uploader": "npm --prefix frontends/file-uploader run build",
    "build:guide-posts": "npm --prefix frontends/guide-posts run build",
    "build:proxy-release": "npm --prefix frontends/proxy-release run build",
    "build:materials-library": "npm --prefix frontends/materials-library run build",
    "build:frontends": "npm run build:image-board && npm run build:file-uploader && npm run build:guide-posts && npm run build:proxy-release && npm run build:materials-library",
    "build:docs": "node tools/build_docs.mjs",
    "test:image-board": "npm --prefix frontends/image-board test -- --run",
    "test:file-uploader": "npm --prefix frontends/file-uploader test -- --run",
    "release:image-board": "powershell -ExecutionPolicy Bypass -File ./tools/build_release.ps1 -FrontendId image-board",
    "release:file-uploader": "powershell -ExecutionPolicy Bypass -File ./tools/build_release.ps1 -FrontendId file-uploader"
  }
}
